
@using CrazyCV.Models

<article class="project-card" id="@Item.Id">

    <h3>@Item.Title</h3>

    <p>@Item.Description</p>

    <div class="tech-tags">
        @foreach (var technology in Item.Technologies)
        {
            <span class="tech-tag">@technology</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Item.GitHubUrl))
    {
        <a href="@Item.GitHubUrl"
           target="_blank"
           rel="noopener noreferrer">
            View on GitHub ↗
        </a>
    }

</article>

@code {
    [Parameter]
    public Project Item { get; set; } = default!;
}
