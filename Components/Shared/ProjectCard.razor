@using CrazyCV.Models

<article class="project-card" id="@Item.Id">

    
<div class="project-cover @Item.Id">

    @if (!string.IsNullOrWhiteSpace(Item.ImagePath))
    {
        <img src="@Item.ImagePath"
             alt="Screenshot from @Item.Title"
             loading="lazy" />
    }
    else
    {
        <div class="project-cover-placeholder">
            <span>FEATURED PROJECT</span>
            <strong>@Item.Title</strong>
        </div>
    }

</div>


    <h3>@Item.Title</h3>

    <p>@Item.Description</p>

    <div class="tech-tags">
        @foreach (var technology in Item.Technologies)
        {
            <span class="tech-tag">@technology</span>
        }
    </div>

    <a class="details-link" href="@($"/projects/{Item.Id}")">
        View project details ↗
    </a>

    @if (!string.IsNullOrWhiteSpace(Item.GitHubUrl))
    {
        <a href="@Item.GitHubUrl" target="_blank" rel="noopener noreferrer">
            View on GitHub ↗
        </a>
    }

</article>

@code {
    [Parameter]
    public Project Item { get; set; } = default!;
}
