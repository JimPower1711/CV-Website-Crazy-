@using CrazyCV.Models

<section class="identity-key-hero" id="home" aria-labelledby="identity-key-heading">
    <div class="identity-intro">
        <p class="identity-name">Jonas Palmgren Hesmyr</p>
        <p class="identity-role">IT Student <span aria-hidden="true">•</span> Developer <span aria-hidden="true">•</span> Problem Solver</p>
        <span class="identity-divider" aria-hidden="true"></span>
        <h1 id="identity-key-heading">Building beyond the ordinary.</h1>
    </div>

    <div class="identity-stage">
        <div class="artifact-halo" aria-hidden="true"></div>
        <div class="orbit orbit-outer" aria-hidden="true"></div>
        <div class="orbit orbit-middle" aria-hidden="true"></div>
        <div class="orbit orbit-inner" aria-hidden="true"></div>
        <div class="energy-arc energy-arc-one" aria-hidden="true"></div>
        <div class="energy-arc energy-arc-two" aria-hidden="true"></div>
        <div class="orbit-detail orbit-detail-one" aria-hidden="true"></div>
        <div class="orbit-detail orbit-detail-two" aria-hidden="true"></div>
        <div class="orbit-detail orbit-detail-three" aria-hidden="true"></div>
        <div class="orbit-detail orbit-detail-four" aria-hidden="true"></div>

        <div class="artifact-ground-shadow" aria-hidden="true">
            <span></span>
        </div>

        <div class="identity-artifact" role="img" aria-label="Floating metallic Identity Key concept artifact">
            <div class="artifact-motion">
                <div class="artifact-depth" aria-hidden="true"></div>
                <div class="artifact-rim" aria-hidden="true"></div>
                <div class="artifact-face">
                    <span class="artifact-reflection" aria-hidden="true"></span>

                    <span class="artifact-glyph artifact-glyph-one artifact-symbol-about" aria-hidden="true">
                        <svg viewBox="0 0 80 80">
                            <path d="M12 37 29 10l24 7 15 24-20 27-27-6Z" />
                            <path d="m29 10 7 27-24 0m24 0 17-20M36 37l12 31M21 62l15-25" />
                            <circle class="glyph-dot" cx="57" cy="47" r="3.2" />
                        </svg>
                    </span>

                    <span class="artifact-glyph artifact-glyph-two artifact-symbol-projects" aria-hidden="true">
                        <svg viewBox="0 0 80 80">
                            <path d="m9 29 22-16 18 15-8 24-25 1Z" />
                            <path d="m49 28 17-10 7 23-17 20-15-9Z" />
                            <path d="m31 13 4 25-26-9m26 9 14-10m7 33 0-20 17 0M16 53l8 15" />
                            <circle class="glyph-dot" cx="29" cy="62" r="3.2" />
                        </svg>
                    </span>

                    <span class="artifact-glyph artifact-glyph-three artifact-symbol-beyond" aria-hidden="true">
                        <svg viewBox="0 0 80 80">
                            <path d="M11 42 27 13l24 2 17 24-14 27-29 2Z" />
                            <path d="m27 13 8 29-24 0m24 0 16-27m-16 27 19 24M25 68l10-26" />
                            <circle class="glyph-ring" cx="59" cy="27" r="5" />
                        </svg>
                    </span>

                    <span class="artifact-glyph artifact-glyph-skills artifact-symbol-skills" aria-hidden="true">
                        <svg viewBox="0 0 80 80">
                            <path d="M10 22 30 9l15 18-12 20-23-7Z" />
                            <path d="m33 47 19-20 17 18-9 25-24-5Z" />
                            <path d="m30 9-1 25-19-12m19 12 16-7m7 0 2 25-21-5m21 5 15-7" />
                            <circle class="glyph-dot" cx="18" cy="57" r="3" />
                            <circle class="glyph-dot" cx="27" cy="67" r="2.4" />
                        </svg>
                    </span>

                    <span class="artifact-glyph artifact-glyph-experience artifact-symbol-experience" aria-hidden="true">
                        <svg viewBox="0 0 80 80">
                            <path d="m13 24 25-13 26 15-8 28-27 13-18-20Z" />
                            <path d="m38 11 4 28-29-15m29 15 22-13M29 67l13-28 14 15" />
                            <path d="m58 61 10-8 4 13-9 7Z" />
                            <circle class="glyph-ring" cx="21" cy="53" r="4.5" />
                        </svg>
                    </span>

                    <span class="artifact-glyph artifact-glyph-contact artifact-symbol-contact" aria-hidden="true">
                        <svg viewBox="0 0 80 80">
                            <path d="m9 38 17-24 25 8 2 26-22 19-20-12Z" />
                            <path d="m26 14 8 28-25-4m25 4 17-20M31 67l3-25 19 6" />
                            <path d="m57 13 13 8-5 14-12-5Z" />
                            <circle class="glyph-dot" cx="65" cy="55" r="3.2" />
                            <circle class="glyph-dot" cx="71" cy="66" r="2.4" />
                        </svg>
                    </span>
                </div>
            </div>
        </div>

        <svg class="symbol-connections" viewBox="0 0 1280 680" preserveAspectRatio="none" aria-hidden="true">
            <path class="symbol-connection symbol-connection-about" d="M415 116H482L548 188 570 198" />
            <circle class="symbol-anchor symbol-anchor-about" cx="570" cy="198" r="3" />
            <path class="symbol-connection symbol-connection-skills" d="M350 320H438L486 331H510" />
            <circle class="symbol-anchor symbol-anchor-skills" cx="510" cy="331" r="3" />
            <path class="symbol-connection symbol-connection-beyond" d="M388 558H458L520 490 567 467" />
            <circle class="symbol-anchor symbol-anchor-beyond" cx="567" cy="467" r="3" />
            <path class="symbol-connection symbol-connection-projects" d="M891 137H820L752 180 715 198" />
            <circle class="symbol-anchor symbol-anchor-projects" cx="715" cy="198" r="3" />
            <path class="symbol-connection symbol-connection-experience" d="M955 339H862L811 331H775" />
            <circle class="symbol-anchor symbol-anchor-experience" cx="775" cy="331" r="3" />
            <path class="symbol-connection symbol-connection-contact" d="M878 558H810L752 490 718 467" />
            <circle class="symbol-anchor symbol-anchor-contact" cx="718" cy="467" r="3" />
        </svg>

        <svg class="identity-icon-definitions" aria-hidden="true">
            <defs>
                <symbol id="identity-about-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="3.25" />
                    <path d="M5.5 19c.5-4 2.65-6 6.5-6s6 2 6.5 6Z" />
                </symbol>
                <symbol id="identity-projects-icon" viewBox="0 0 24 24">
                    <path d="M3.5 6.5h6l2 2h9v10h-17Z" />
                    <path d="M3.5 8.5h17" />
                </symbol>
                <symbol id="identity-skills-icon" viewBox="0 0 24 24">
                    <path d="M4 19V13h4v6M10 19V8h4v11M16 19V4h4v15" />
                </symbol>
                <symbol id="identity-journey-icon" viewBox="0 0 24 24">
                    <path d="m3 9 9-5 9 5-9 5Z" />
                    <path d="M6.5 11v5.5c3.5 2 7.5 2 11 0V11M21 9v6" />
                </symbol>
                <symbol id="identity-beyond-icon" viewBox="0 0 24 24">
                    <path d="M19.5 4.5c-7 .25-12.5 3.5-14 10.5-.5 2.2.8 4 3 4.5 7-1.5 10.25-7 11-15Z" />
                    <path d="M7 17c2.5-3.25 5.25-5.75 8.5-7.5" />
                </symbol>
                <symbol id="identity-contact-icon" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="1" />
                    <path d="m4 7 8 6 8-6" />
                </symbol>
            </defs>
        </svg>

        <ul class="identity-map" aria-label="Portfolio areas">
            <li class="@GetPointClass(PortfolioSection.About, "point-about is-left")">
                <a class="point-link"
                   href="@GetSectionUrl(PortfolioSection.About)"
                   aria-current="@(ActiveSection == PortfolioSection.About ? "page" : null)">
                    <span class="point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#identity-about-icon"></use></svg>
                    </span>
                    <span class="point-copy"><strong>About</strong><small>Who I am</small></span>
                    <span class="point-connector" aria-hidden="true"></span>
                </a>
            </li>

            <li class="@GetPointClass(PortfolioSection.Skills, "point-skills is-left")">
                <a class="point-link"
                   href="@GetSectionUrl(PortfolioSection.Skills)"
                   aria-current="@(ActiveSection == PortfolioSection.Skills ? "page" : null)">
                    <span class="point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#identity-skills-icon"></use></svg>
                    </span>
                    <span class="point-copy"><strong>Skills</strong><small>Tools &amp; expertise</small></span>
                    <span class="point-connector" aria-hidden="true"></span>
                </a>
            </li>

            <li class="@GetPointClass(PortfolioSection.Beyond, "point-beyond is-left")">
                <a class="point-link"
                   href="@GetSectionUrl(PortfolioSection.Beyond)"
                   aria-current="@(ActiveSection == PortfolioSection.Beyond ? "page" : null)">
                    <span class="point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#identity-beyond-icon"></use></svg>
                    </span>
                    <span class="point-copy"><strong>Beyond the Code</strong><small>More than tech</small></span>
                    <span class="point-connector" aria-hidden="true"></span>
                </a>
            </li>

            <li class="@GetPointClass(PortfolioSection.Projects, "point-projects is-right")">
                <a class="point-link"
                   href="@GetSectionUrl(PortfolioSection.Projects)"
                   aria-current="@(ActiveSection == PortfolioSection.Projects ? "page" : null)">
                    <span class="point-connector" aria-hidden="true"></span>
                    <span class="point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#identity-projects-icon"></use></svg>
                    </span>
                    <span class="point-copy"><strong>Projects</strong><small>What I build</small></span>
                </a>
            </li>

            <li class="@GetPointClass(PortfolioSection.Experience, "point-journey is-right")">
                <a class="point-link"
                   href="@GetSectionUrl(PortfolioSection.Experience)"
                   aria-current="@(ActiveSection == PortfolioSection.Experience ? "page" : null)">
                    <span class="point-connector" aria-hidden="true"></span>
                    <span class="point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#identity-journey-icon"></use></svg>
                    </span>
                    <span class="point-copy"><strong>Experience &amp; Education</strong><small>My journey</small></span>
                </a>
            </li>

            <li class="@GetPointClass(PortfolioSection.Contact, "point-contact is-right")">
                <a class="point-link"
                   href="@GetSectionUrl(PortfolioSection.Contact)"
                   aria-current="@(ActiveSection == PortfolioSection.Contact ? "page" : null)">
                    <span class="point-connector" aria-hidden="true"></span>
                    <span class="point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#identity-contact-icon"></use></svg>
                    </span>
                    <span class="point-copy"><strong>Contact</strong><small>Let's connect</small></span>
                </a>
            </li>
        </ul>

        <p class="artifact-status">Motion artifact study <span aria-hidden="true">/</span> 3D asset to follow</p>
    </div>

    <div class="identity-footer" aria-hidden="true">
        <span class="scroll-cue"><i></i>Scroll to explore</span>
        <span>Ideas <b>/</b> Code <b>/</b> People <b>/</b> Impact</span>
    </div>
</section>

@code {
    [Parameter]
    public PortfolioSection ActiveSection { get; set; } = PortfolioSection.About;

    private static string GetSectionUrl(PortfolioSection section) =>
        $"/?section={section.ToSlug()}#portfolio-explorer";

    private string GetPointClass(PortfolioSection section, string positionClasses) =>
        $"identity-point {positionClasses}{(ActiveSection == section ? " is-active" : string.Empty)}";
}
