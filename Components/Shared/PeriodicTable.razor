<section class="skills" id="skills">

    <p class="skills-label">02 / TECH STACK</p>
    <h2>The periodic table of my stack.</h2>


    <div class="category-filters">

        @foreach (var category in categories)
        {
            <button type="button" class="filter-button @(selectedCategory == category ? "active" : "")"
                    @onclick="() => SelectCategory(category)">
                @category
            </button>
        }

    </div>

    
    <div class="skill-grid">

        @foreach (var skill in FilteredSkills)
        {
            <button class="skill-tile" type="button" @onclick="() => SelectSkill(skill)">

                <span class="skill-symbol">
                    @skill.Symbol
                </span>

                <span class="skill-name">
                    @skill.Name
                </span>

            </button>
        }

    </div>

    
@if (selectedSkill != null)
{
    <div class="skill-detail">

        <h3>@selectedSkill.Name</h3>

        <p>@selectedSkill.Description</p>

        @if (selectedSkill.ProjectId != null)
        {
            <a class="skill-project-link"
               href="@($"#{selectedSkill.ProjectId}")">

                <span>
                    Used in: @selectedSkill.ProjectName
                </span>

                <span aria-hidden="true">↗</span>

            </a>
        }

    </div>
}


</section>

@code {

    private record Skill(
        string Symbol,
        string Name,
        string Description,
        string Category,
        string? ProjectName = null,
        string? ProjectId = null
);
    
    private readonly List<Skill> skills = new()
{
    new("C#", "C#", "ASP.NET Core development.", "Languages", "Galactic Slicer", "galactic-slicer"),
    new("Ja", "Java", "Object-oriented programming.", "Languages"),
    new("Py", "Python", "Machine learning and data analysis.",
    "Languages", "Rocket League Skill Detection", "rocket-league-ml"),
    new("JS", "JavaScript", "Interactive web applications.", "Languages"),

    new("Ht", "HTML", "Website structure.", "Frontend"),
    new("Cs", "CSS", "Styling and responsive design.", "Frontend"),
    new("Re", "React", "Component-based user interfaces.", "Frontend"),

    new("Nt", ".NET", "Backend and web development.",
    "Backend", "Galactic Slicer", "galactic-slicer"),
    new("EF", "Entity Framework", "Database access and migrations.",
    "Backend", "Galactic Slicer", "galactic-slicer"),

    new("SQL", "SQL", "Database queries.", "Databases"),
    new("Sq", "SQLite", "Relational database management.", "Databases"),

    new("Git", "Git", "Version control.", "Tools"),
    new("Li", "Linux", "Operating systems and terminal.", "Tools"),

    new("Cy", "Cybersecurity", "Security principles and cryptography.", "Security")
};

    private Skill? selectedSkill;

    private void SelectSkill(Skill skill)
    {
        selectedSkill = skill;
    }


    private readonly string[] categories =
    {
    "All",
    "Languages",
    "Frontend",
    "Backend",
    "Databases",
    "Tools",
    "Security"
};

    private string selectedCategory = "All";

    private IEnumerable<Skill> FilteredSkills =>
        selectedCategory == "All"
            ? skills
            : skills.Where(skill => skill.Category == selectedCategory);

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        selectedSkill = null;
    }


}
