
@page "/"

@using CrazyCV.Components.Shared
@using CrazyCV.Models

<PageTitle>Crazy CV | Portfolio</PageTitle>

<main>
    <IdentityKeyHero ActiveSection="@ActiveSection" />
    <PortfolioExplorer ActiveSection="@ActiveSection" />
</main>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "section")]
    public string? SelectedSection { get; set; }

    private PortfolioSection ActiveSection =>
        PortfolioSectionRoute.Parse(SelectedSection);
}
