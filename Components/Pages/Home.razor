
@page "/"
@using CrazyCV.Components.Shared;

<PageTitle>Crazy CV | Portfolio</PageTitle>

<main>

    <section class="hero" id="home">

        <div class="hero-content">

            <p class="eyebrow">
                IT STUDENT • DEVELOPER • PROBLEM SOLVER
            </p>

            <h1>
                Building beyond
                <span>the ordinary.</span>
            </h1>

            <p class="hero-description">
                I'm an Information Technology student at OsloMet,
                passionate about development, technology,
                and creative problem solving.
            </p>

            <a class="hero-button" href="#about">
                Explore more ↗
            </a>

        </div>

        <div class="hero-visual">

            <div class="avatar-placeholder">
                <div class="avatar-icon">✦</div>

                <p>CREATIVE HERO AVATAR</p>
                <small>Coming soon</small>
            </div>

        </div>

    </section>

    <section class="about" id="about">

        <p class="section-label">01 / ABOUT ME</p>

        <h2>Beyond the Code.</h2>

        <p>
            I enjoy combining technology, creativity,
            and continuous improvement.
        </p>

    </section>

    <PeriodicTable />

    
<section class="projects" id="projects">

    <p class="section-label">03 / PROJECTS</p>

    <h2>Selected Work.</h2>

    <p class="projects-intro">
        A selection of projects I've worked on.
    </p>

    <div class="project-grid">

        <article class="project-card" id="galactic-slicer">
            <span>01 / WEB DEVELOPMENT</span>

            <h3>Galactic Slicer</h3>

            <p>
                A Star Wars-inspired gamification platform
                for learning cybersecurity concepts.
            </p>

            <small>C# · ASP.NET Core · SQLite</small>
        </article>

        <article class="project-card" id="rocket-league-ml">
            <span>02 / MACHINE LEARNING</span>

            <h3>Rocket League Skill Detection</h3>

            <p>
                A machine learning project focused on
                recognizing gameplay skills from data.
            </p>

            <small>Python · Pandas · Scikit-learn</small>
        </article>

    </div>

</section>


</main>
