@page "/"
@using CrazyCV.Components.Shared;
@using CrazyCV.Models;
@using CrazyCV.Services;
@inject ProjectService ProjectService


<PageTitle>Crazy CV | Portfolio</PageTitle>

<main>

    <section class="hero" id="home">

        <div class="hero-content">

            <p class="eyebrow">
                IT STUDENT • DEVELOPER • PROBLEM SOLVER
            </p>

            <h1>
                Building beyond
                <span>the ordinary.</span>
            </h1>

            <p class="hero-description">
                I'm an Information Technology student at OsloMet,
                passionate about development, technology,
                and creative problem solving.
            </p>

            <a class="hero-button" href="#about">
                Explore more ↗
            </a>

        </div>

        
       
        <div class="hero-visual">

            <img class="hero-avatar-fallback" src="/images/projects/crazycv-avatar.png"
                 alt="Creative developer avatar wearing a Superman hoodie" />

            <video class="hero-avatar-video" autoplay muted loop playsinline preload="metadata"
                   poster="/images/projects/crazycv-avatar.png" aria-hidden="true">

                <source src="/videos/crazycv-avatar-motion.mp4" type="video/mp4" />

            </video>

        </div>



    </section>

    
    
<section class="about" id="about">

    <div class="about-grid">

        <div class="about-content">

            <p class="section-label">01 / ABOUT ME</p>

            <h2>More than just code.</h2>

            <p>
                I'm an Information Technology student
                at OsloMet with a passion for creating,
                learning and solving problems.
            </p>

            <p>
                But there's more to me than technology.
                Flip my digital identity card to discover
                what drives me outside of programming.
            </p>

        </div>

        <IdentityCard />

    </div>

</section>



    <PeriodicTable />

    
    <section class="projects" id="projects">

        <p class="section-label">03 / PROJECTS</p>

        <h2>Selected Work.</h2>

        <p class="projects-intro">
            A selection of projects I've worked on.
        </p>

        <div class="project-grid">

            
            <div class="project-grid">

                @foreach (var project in ProjectService.GetAll())
                {
                    <ProjectCard Item="@project" @key="project.Id" />
                }

            </div>


        </div>

    </section>


    <ExperienceTimeline />


</main>

