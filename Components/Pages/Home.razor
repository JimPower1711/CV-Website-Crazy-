
@page "/"

@using CrazyCV.Components.Shared
@using CrazyCV.Models
@using CrazyCV.Services

@inject ProjectService ProjectService

<PageTitle>Crazy CV | Portfolio</PageTitle>

<main>

    <!-- ================================= -->
    <!-- 01 - HERO SECTION -->
    <!-- ================================= -->

    <section class="hero" id="home">

        <div class="hero-content">

            <p class="eyebrow">
                IT STUDENT • DEVELOPER • PROBLEM SOLVER
            </p>

            <h1>
                Building beyond
                <span>the ordinary.</span>
            </h1>

            <p class="hero-description">
                I'm an Information Technology student at OsloMet,
                passionate about development, technology
                and creative problem solving.
            </p>

            <div class="hero-actions">

                <a class="hero-button"
                   href="#portfolio"
                   @onclick="ShowProjects">
                    Explore my work ↗
                </a>

                <button type="button"
                        class="hero-about-button"
                        aria-expanded="@showIdentityCard"
                        aria-controls="identity-stage"
                        @onclick="ToggleIdentityCard">

                    @(showIdentityCard
                        ? "Back to avatar ↶"
                        : "Get to know me ↗")

                </button>

            </div>

        </div>

        <!-- INTERACTIVE IDENTITY -->

        <div class="hero-stage" id="about">

            <div id="identity-stage" class="hero-stage-content">

                @if (showIdentityCard)
                {
                    <div class="hero-identity-view">
                        <IdentityCard />
                    </div>
                }
                else
                {
                    <div class="hero-visual">

                        <img src="/images/projects/crazycv-avatar.png"
                             alt="Creative developer avatar wearing a Superman hoodie"
                             class="hero-avatar" />

                    </div>

                    <button type="button"
                            class="hero-identity-ticket"
                            @onclick="ToggleIdentityCard">

                        <span class="ticket-label">
                            JPH / DIGITAL IDENTITY
                        </span>

                        <span class="ticket-title">
                            Discover who I am ↗
                        </span>

                    </button>
                }

            </div>

        </div>

    </section>


    <!-- ================================= -->
    <!-- 02 - PORTFOLIO LAB -->
    <!-- ================================= -->

    <section class="portfolio-lab" id="portfolio">

        <div class="portfolio-lab-header">

            <div>

                <p class="section-label">
                    02 / EXPLORE MY WORK
                </p>

                <h2>The Portfolio Lab.</h2>

                <p class="portfolio-lab-description">
                    Explore the technologies I work with
                    and the projects I've built.
                </p>

            </div>

            <span class="portfolio-lab-decoration">
                ✦
            </span>

        </div>

        <!-- TAB NAVIGATION -->

        <div class="portfolio-tabs">

            <button type="button"
                    id="skills"
                    class="portfolio-tab @(activePortfolioTab == "skills" ? "active" : "")"
                    aria-pressed="@(activePortfolioTab == "skills")"
                    @onclick="ShowSkills">

                <span>01</span>
                Skills

            </button>

            <button type="button"
                    id="projects"
                    class="portfolio-tab @(activePortfolioTab == "projects" ? "active" : "")"
                    aria-pressed="@(activePortfolioTab == "projects")"
                    @onclick="ShowProjects">

                <span>02</span>
                Projects

            </button>

        </div>


        <!-- SKILLS VIEW -->

        <div class="portfolio-panel"
             hidden="@(activePortfolioTab != "skills")">

            <div class="portfolio-panel-heading">
                <span>TECHNOLOGY EXPLORER</span>
                <span>01 / 02</span>
            </div>

            <PeriodicTable />

        </div>


        <!-- PROJECTS VIEW -->

        <div class="portfolio-panel"
             hidden="@(activePortfolioTab != "projects")">

            <div class="portfolio-panel-heading">
                <span>SELECTED WORK</span>
                <span>02 / 02</span>
            </div>

            <div class="project-grid">

                @foreach (var projectItem in ProjectService.GetAll())
                {
                    <ProjectCard Item="@projectItem"
                                 @key="projectItem.Id" />
                }

            </div>

        </div>

    </section>


    <!-- ================================= -->
    <!-- 03 - EXPERIENCE & EDUCATION -->
    <!-- ================================= -->

    <ExperienceTimeline />

</main>

@code {

    // HERO - IDENTITY CARD

    private bool showIdentityCard = false;

    private void ToggleIdentityCard()
    {
        showIdentityCard = !showIdentityCard;
    }


    // PORTFOLIO LAB

    private string activePortfolioTab = "skills";

    private void ShowSkills()
    {
        activePortfolioTab = "skills";
    }

    private void ShowProjects()
    {
        activePortfolioTab = "projects";
    }

}
