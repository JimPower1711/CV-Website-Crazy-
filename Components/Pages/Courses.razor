            new()
            {
                new("DATA1500", "Databaser"),
                new("DATS2300", "Algoritmer og datastrukturer"),
                new("DATA2500", "Operativsystemer"),
                new("DATA2410", "Datanettverk og skytjenester"),
                new("ADSE1310", "Internet of Things")
            }
        ),

        new(
            "Design & Mathematics",
            "PREVIOUS COURSEWORK",
            new()
            {
                new("ADSE2100", "Menneske-maskin-interaksjon"),
                new("DAPE1300", "Diskret matematikk"),
